{
  "name": "twc-stafford-music-scheduler",
  "version": "1.0.2",
  "description": "TWC Stafford Music Scheduler desktop app",
  "main": "dist-electron/main.js",
  "author": "TWC Stafford",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --configLoader runner\" \"wait-on http://localhost:5173 && electron .\"",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "tsc -b && vite --configLoader runner build && tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "test": "tsc -p electron/tsconfig.json && node --test src/schedule.test.mjs",
    "package:win": "npm run build && electron-builder --win nsis",
    "release:win": "npm run build && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "concurrently": "^9.1.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.twcstafford.musicscheduler",
    "productName": "TWC Stafford Music Scheduler",
    "directories": { "output": "release" },
    "extraResources": [{ "from": "assets/icons/app-icon-release.ico", "to": "app-icon.ico" }],
    "files": ["dist/**/*", "dist-electron/**/*", "package.json"],
    "win": { "target": "nsis", "icon": "assets/icons/app-icon-release.ico", "artifactName": "TWC-Stafford-Music-Scheduler-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "installerIcon": "assets/icons/app-icon-release.ico", "uninstallerIcon": "assets/icons/app-icon-release.ico" },
    "publish": [{ "provider": "github", "releaseType": "release" }]
  }
}
